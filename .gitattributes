# Repository metadata baseline: normalize text files to LF in the repository.
* text=auto eol=lf

# Explicit text types
*.md text
*.markdown text
*.txt text
*.json text
*.jsonc text
*.toml text
*.yml text
*.yaml text
*.rs text
*.lock text

# Binary types
*.png binary
*.jpg binary
*.zst binary
# Vendored VT corpus fixtures: byte-stable on every platform checkout (CRLF
# bytes are intentional corpus content). Never convert or diff.
*.bin binary
